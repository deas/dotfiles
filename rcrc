# config/nix/env/{flake.nix,flake.lock} are excluded deliberately: they are the
# SOURCE of the nix package env, not a dotfile. `just nix-sync` copies them
# into a build dir, because nix resolves a symlink inside its store copy of a
# flake against that copy — a linked flake.nix is a trap, not a shortcut. The
# pkgs.d/ fragments beside them ARE linked; composing those layers is rcm's job.
EXCLUDES="*.md hyprland-wiki LICENSE zshrc-zplug vimrc vimrc.bundles clojure-sc zsh bash samples misc config/carapace/specs-ignore config/systemd/user/mcp-playwright.service config/nix/env/flake.nix config/nix/env/flake.lock"
# dotfiles-user is a provisioning layer's per-user overlay, absent on a
# workstation — rcm tolerates a missing dir. First-listed wins a collision.
DOTFILES_DIRS="$HOME/dotfiles-local $HOME/dotfiles-user $HOME/dotfiles"
# Machine profile. Every machine sources THIS file, so the profile is recognized
# here rather than selected by a consumer's own rcrc — see README.md "Profiles
# (rcm tags)". Desktop must be proven (the workstations run Omarchy); anything
# unrecognized falls to node, which is the harmless direction.
if [ -n "${RCM_PROFILE:-}" ]; then
  TAGS="$RCM_PROFILE"
elif grep -qE '^ID="?omarchy"?$' /etc/os-release 2>/dev/null; then
  TAGS="desktop"
else
  TAGS="node"
fi
# Per-user overlay, in three tiers, MOST SPECIFIC FIRST — rcm resolves a
# collision to the first tag listed, so this is the order that lets a seat
# override the profile rather than be shadowed by it:
#
#   tag-user-<login>-<profile>/  this seat, on this kind of machine
#   tag-user-<login>/            this seat everywhere (login is not machine-scoped:
#                                `deas` is both a workstation login and a node seat)
#   tag-<profile>/               every seat on this kind of machine
#
# rcm skips a tag with no directory, so unused tiers cost nothing. `id -un`
# rather than $USER, which is unset under systemd units, cron and some su
# invocations — that would yield the tag `user-` and match a stray directory
# instead of nothing. $TAGS still holds exactly the profile tag at this point.
TAGS="user-$(id -un)-$TAGS user-$(id -un) $TAGS"
# rcm shells out to the `hostname` binary when HOSTNAME is unset, and an Arch
# node has none — the run then errors and host-<name>/ never resolves.
HOSTNAME="${HOSTNAME:-$(uname -n)}"
