{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // opencode >= 2.2 made the Go subscription its own integration; it no longer
    // rides the Console credential. sovera1gn-n0des delivers the key per seat
    // (`secret_files:`, ~/.config/s0n/secrets/). A seat without the file still
    // starts, it just cannot call opencode-go/* models.
    "opencode-go": {
      "options": {
        "apiKey": "{file:~/.config/s0n/secrets/opencode-go.key}",
      },
    },
    // NVIDIA NIM (build.nvidia.com). models.dev already knows the provider and
    // its base URL; only the key comes from the seat's secret file. Not a default.
    "nvidia": {
      "options": {
        "apiKey": "{file:~/.config/s0n/secrets/nvidia.key}",
      },
      // The chat models that answered in under 4s on the free tier (probed
      // 2026-11-15). The catalog lags the live list: several are missing from it,
      // and many it does list now 404 or time out.
      "models": {
        "nvidia/nemotron-3.5-bolt-e4b": { "name": "Nemotron 3.5 Bolt E4B" },
        "poolside/laguna-xs-2.1": { "name": "Laguna XS 2.1" },
        "stepfun-ai/step-5-preview": { "name": "Step 5 Preview" },
        "nvidia/nemotron-3.5-super-vl-120b-a12b": { "name": "Nemotron 3.5 Super VL 120B" },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning": { "name": "Nemotron 3 Nano Omni 30B Reasoning" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra 550B" },
        "nvidia/nemotron-3.5-lightning-30b-a3b": { "name": "Nemotron 3.5 Lightning 30B" },
        "mistralai/mistral-large-4-1t-a52b": { "name": "Mistral Large 4" },
      },
    },
  },
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-sonnet-4.5",
  // "model": "openrouter/minimax/minimax-m2",
  // "small_model": "openrouter/minimax/minimax-m2",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      // "headers": {
      //  "CONTEXT7_API_KEY": "YOUR_API_KEY"
      // },
      "enabled": true,
    },
    "huggingface": {
      "type": "remote",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HF_TOKEN_READ}",
      },
      "url": "https://huggingface.co/mcp",
    },
    "github": {
      "type": "remote",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
      "url": "https://api.githubcopilot.com/mcp/",
    },
    // "tavily": {
    //   "type": "local",
    //   "enabled": true,
    //   "command": ["npx", "-y", "tavily-mcp@latest"],
    //   "environment": {
    //     "TAVILY_API_KEY": "{env:TAVILY_API_KEY}",
    //   },
    // },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
    },
    // The following is vibe coded - idea is to use docker
    // "tavily-sse": {
    //  "enabled": false,
    //  "type": "remote",
    //  "url": "http://127.0.0.1:8001/sse",
    //  "headers": {
    //    "Authorization": "Bearer {env:TAVILY_API_KEY}",
    //  },
    // },
  },
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-pty",
    // "oh-my-opencode",
    // "opencode-notifier",
    // "opencode-zellij-namer",
    // "opencode-skillful",
  ],
  // instructions should be harnomonic across clis
  "instructions": ["CONVENTIONS.md", "AGENTS.md"],
  // "permission": {
  //   "*": "allow",
  //   "external_directory": "ask",
  //   "doom_loop": "ask",
  //   "read": {
  //     "*": "allow",
  //     "*.env": "deny",
  //     "*.env.*": "deny",
  //     "*.env.example": "allow",
  //   },
  // },
  // "permission": {
  //  "read": "allow",
  //  "edit": "allow",
  //  "bash": "allow",
  //  "external_directory": "ask",
  // },
  // "permission": "allow",
  // "permission": {
  // "*": "ask",
  // "bash": "allow",
  // "edit": "deny",
  //},
}
